generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model ITEM {
  id                Int                       @id @default(autoincrement())
  team              String                    @db.VarChar(10)
  status            ITEM_STATUS
  COLOR_id          Int
  READ_CYCLE_id     Int                       @unique
  ORDER_LINE_id     Int?
  
  COLOR             COLOR                     @relation(fields: [COLOR_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  READ_CYCLE        READ_CYCLE                @relation(fields: [READ_CYCLE_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ORDER_LINE        ORDER_LINE?                @relation(fields: [ORDER_LINE_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  SELECTION_HISTORY SELECTION_HISTORY[]
  ITEM_HISTORY      ITEM_HISTORY[]

  @@index([COLOR_id])
  @@index([READ_CYCLE_id])
}

model ITEM_HISTORY {
  id                Int                       @id @default(autoincrement())
  status            ITEM_STATUS
  createdAt         DateTime                  @default(now()) @db.Timestamp(0)
  ITEM_id           Int

  ITEM              ITEM                      @relation(fields: [ITEM_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ITEM_id])
}

model SELECTION_HISTORY {
  id              Int                        @id @default(autoincrement())                        
  status          DECISION_STATUS            @default(IN_PROCESS)
  createdAt       DateTime                   @default(now()) @db.Timestamp(0)
  ITEM_id         Int

  ITEM            ITEM                       @relation(fields: [ITEM_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ITEM_id])
}

model ORDER {
  id                Int                       @id @default(autoincrement())
  status            ORDER_STATUS
  createdAt         DateTime                  @default(now()) @db.Timestamp(0)
  updatedAt         DateTime                  @updatedAt @db.Timestamp(0)
  completedAt       DateTime?                 @db.Timestamp(0)

  ORDER_LINE        ORDER_LINE[]
}

model ORDER_LINE {
  id               Int                       @id @default(autoincrement())
  quantity         Int
  quantityReceived Int                       @default(0)
  ORDER_id         Int
  COLOR_id         Int

  ORDER            ORDER                     @relation(fields: [ORDER_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  COLOR            COLOR                     @relation(fields: [COLOR_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  ITEM             ITEM[]

  @@index([ORDER_id])
  @@index([COLOR_id])
}

model READ_CYCLE {
  id              Int                        @id @default(autoincrement())
  scannedAt       DateTime                   @default(now()) @db.Timestamp(0)
  qrValue         String                     @db.VarChar(45)
  hue             Int
  saturation      Int
  value           Int

  ITEM            ITEM?
}

model COLOR {
  id              Int                         @id @default(autoincrement())
  name            String                      @unique @db.VarChar(10)
  hueMin          Int
  hueMax          Int
  saturationMin   Int
  saturationMax   Int
  valueMin        Int
  valueMax        Int
  hex             String                      @unique @db.Char(7)
  
  ITEM            ITEM[]
  ORDER_LINES     ORDER_LINE[]
}

enum ORDER_STATUS {
  IN_PROCESS
  COMPLETED
  CANCELLED
}

enum DECISION {
  PASS
  ORDER
  STOCK
}

enum DECISION_STATUS {
  IN_PROCESS
  CONFIRMED
  FAILED
}

enum ITEM_STATUS {
  AVAILABLE
  ORDERED
  IN_PROCESS
  EXTERNAL
}