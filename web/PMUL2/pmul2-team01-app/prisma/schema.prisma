generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model ITEM {
  id                Int                       @id @default(autoincrement())
  team              String?                   @db.VarChar(10)
  decision          DECISION
  orderedAt         DateTime?                 @db.Timestamp(0)
  status            ITEM_STATUS               @default(PROCESS)
  decisionStatus    DECISION_STATUS           @default(PROCESS)
  COLOR_id          Int?
  READ_CYCLE_id     Int?                       @unique
  ORDER_LINE_id     Int?
  
  COLOR             COLOR?                     @relation(fields: [COLOR_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  READ_CYCLE        READ_CYCLE?                @relation(fields: [READ_CYCLE_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ORDER_LINE        ORDER_LINE?               @relation(fields: [ORDER_LINE_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
  SELECTION_HISTORY SELECTION_HISTORY[]
  ITEM_HISTORY      ITEM_HISTORY[]

  @@index([COLOR_id])
  @@index([READ_CYCLE_id])
}

model ITEM_HISTORY {
  id                Int                       @id @default(autoincrement())
  status            ITEM_STATUS               @default(PROCESS)
  createdAt         DateTime                  @default(now()) @db.Timestamp(0)
  ITEM_id           Int

  ITEM              ITEM                      @relation(fields: [ITEM_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ITEM_id])
}

model SELECTION_HISTORY {
  id              Int                         @id @default(autoincrement())                        
  status          DECISION_STATUS             @default(PROCESS)
  createdAt       DateTime                    @default(now()) @db.Timestamp(0)
  ITEM_id         Int

  ITEM            ITEM                        @relation(fields: [ITEM_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([ITEM_id])
}

model ORDER {
  id                Int                       @id @default(autoincrement())
  status            ORDER_STATUS              @default(PROCESS)
  createdAt         DateTime                  @default(now()) @db.Timestamp(0)
  updatedAt         DateTime                  @updatedAt @db.Timestamp(0)
  completedAt       DateTime?                 @db.Timestamp(0)

  ORDER_LINE        ORDER_LINE[]
}

model ORDER_LINE {
  id               Int                        @id @default(autoincrement())
  quantity         Int
  ORDER_id         Int
  COLOR_id         Int
  status           ORDER_STATUS               @default(PROCESS)

  ORDER            ORDER                      @relation(fields: [ORDER_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  COLOR            COLOR                      @relation(fields: [COLOR_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  ITEM             ITEM[]

  @@index([ORDER_id])
  @@index([COLOR_id])
}

model READ_CYCLE {
  id              Int                         @id @default(autoincrement())
  scannedAt       DateTime                    @default(now()) @db.Timestamp(0)
  qrValue         String                      @db.Text
  hue             Int
  saturation      Int
  value           Int

  ITEM            ITEM?
}

model COLOR {
  id              Int                         @id @default(autoincrement())
  name            String                      @unique @db.VarChar(10)
  hueMin          Int
  hueMax          Int
  saturationMin   Int
  saturationMax   Int
  valueMin        Int
  valueMax        Int
  hex             String                      @unique @db.Char(7)
  status          Boolean
  
  ITEM            ITEM[]
  ORDER_LINES     ORDER_LINE[]
}

enum ORDER_STATUS {
  PROCESS
  COMPLETED
  CANCELLED
}

enum DECISION {
  PASS
  ORDER
  STOCK
}

enum DECISION_STATUS {
  PROCESS
  CONFIRMED
  FAILED
}

enum ITEM_STATUS {
  AVAILABLE
  ORDERED
  PROCESS
  EXTERNAL
  CANCELLED
}