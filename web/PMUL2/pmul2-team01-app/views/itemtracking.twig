{% extends "layout.twig" %}

{% block body %}
<div class="card" x-data="itemDetails({{id}})">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h1>{{title}}</h1>
        <span class="badge fs-5" x-text="item.status"
            :class="{
                'bg-success' : item.status === 'AVAILABLE',
                'bg-warning' : item.status === 'EXTERNAL',
                'bg-info'    : item.status === 'PROCESS',
                'bg-primary' : item.status === 'ORDERED',
                'bg-danger'  : item.status === 'CANCELLED'
            }">
        </span>
    </div>

    <div class="card-body" x-show="item">

        <!-- Info -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header fw-bold">Item</div>
                    <div class="card-body">
                        <table class="table table-sm mb-0">
                            <tr>
                                <td class="text-muted">ID</td>
                                <td class="fw-bold" x-text="'#' + item.id"></td>
                            </tr>
                            <tr>
                                <td class="text-muted">Team</td>
                                <td>
                                    <span x-show="item.team" class="badge bg-secondary" x-text="item.team"></span>
                                    <span x-show="!item.team" class="text-muted">—</span>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Decision</td>
                                <td>
                                    <span class="badge rounded-pill" x-text="item.decision"
                                        :class="{
                                            'bg-info'    : item.decision === 'ORDER',
                                            'bg-primary' : item.decision === 'STOCK',
                                            'bg-warning' : item.decision === 'PASS'
                                        }">
                                    </span>
                                </td>
                            </tr>
                            <tr>
                                <td class="text-muted">Decision status</td>
                                <td>
                                    <span class="badge rounded-pill" x-text="item.decisionStatus"
                                        :class="{
                                            'bg-success' : item.decisionStatus === 'CONFIRMED',
                                            'bg-danger'  : item.decisionStatus === 'FAILED',
                                            'bg-info'    : item.decisionStatus === 'PROCESS'
                                        }">
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header fw-bold">Color</div>
                    <div class="card-body">
                        <template x-if="item.COLOR">
                            <table class="table table-sm mb-0">
                                <tr>
                                    <td class="text-muted">Name</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="p-2 border rounded-circle" :style="{ backgroundColor: item.COLOR.hex }"></span>
                                            <span x-text="item.COLOR.name"></span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-muted">Hex</td>
                                    <td x-text="item.COLOR.hex"></td>
                                </tr>
                            </table>
                        </template>
                        <span x-show="!item.COLOR" class="text-muted">—</span>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-header fw-bold">Scan</div>
                    <div class="card-body">
                        <template x-if="item.READ_CYCLE">
                            <table class="table table-sm mb-0">
                                <tr>
                                    <td class="text-muted">Scanned at</td>
                                    <td x-text="new Date(item.READ_CYCLE.scannedAt).toLocaleString('fr-FR')"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">QR Value</td>
                                    <td x-text="item.READ_CYCLE.qrValue"></td>
                                </tr>
                                <tr>
                                    <td class="text-muted">HSV</td>
                                    <td x-text="`H: ${item.READ_CYCLE.hue}  S: ${item.READ_CYCLE.saturation}  V: ${item.READ_CYCLE.value}`"></td>
                                </tr>
                            </table>
                        </template>
                        <span x-show="!item.READ_CYCLE" class="text-muted">—</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order -->
        <template x-if="item.ORDER_LINE">
            <div class="card mb-4">
                <div class="card-header fw-bold">Linked order</div>
                <div class="card-body">
                    <table class="table table-sm mb-0">
                        <tr>
                            <td class="text-muted">Order</td>
                            <td>
                                <a :href="'/orders/' + item.ORDER_LINE.ORDER.id" class="btn btn-sm btn-primary">
                                    #<span x-text="item.ORDER_LINE.ORDER.id"></span>
                                </a>
                            </td>
                        </tr>
                        <tr>
                            <td class="text-muted">Status</td>
                            <td>
                                <span class="badge rounded-pill" x-text="item.ORDER_LINE.ORDER.status"
                                    :class="{
                                        'bg-success' : item.ORDER_LINE.ORDER.status === 'COMPLETED',
                                        'bg-danger'  : item.ORDER_LINE.ORDER.status === 'CANCELLED',
                                        'bg-info'    : item.ORDER_LINE.ORDER.status === 'PROCESS'
                                    }">
                                </span>
                            </td>
                        </tr>
                    </table>
                </div>
            </div>
        </template>

        <!-- History -->
        <div class="card mb-4">
            <div class="card-header fw-bold">History</div>
            <div class="card-body p-0">
                <table class="table table-striped mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Item status</th>
                            <th>Decision status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template x-for="log in item.SELECTION_HISTORY" :key="log.id">
                            <tr>
                                <td x-text="new Date(log.createdAt).toLocaleString('fr-FR')"></td>
                                <td>
                                    <span class="badge rounded-pill" x-text="log.itemStatus"
                                        :class="{
                                            'bg-success' : log.itemStatus === 'AVAILABLE',
                                            'bg-warning' : log.itemStatus === 'EXTERNAL',
                                            'bg-info'    : log.itemStatus === 'PROCESS',
                                            'bg-primary' : log.itemStatus === 'ORDERED',
                                            'bg-danger'  : log.itemStatus === 'CANCELLED'
                                        }">
                                    </span>
                                </td>
                                <td>
                                    <span class="badge rounded-pill" x-text="log.decisionStatus"
                                        :class="{
                                            'bg-success' : log.decisionStatus === 'CONFIRMED',
                                            'bg-danger'  : log.decisionStatus === 'FAILED',
                                            'bg-info'    : log.decisionStatus === 'PROCESS'
                                        }">
                                    </span>
                                </td>
                            </tr>
                        </template>
                        <tr x-show="item.SELECTION_HISTORY.length === 0">
                            <td colspan="3" class="text-muted text-center">No history</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Update status -->
        <template x-if="item.decisionStatus === 'PROCESS'">
            <div class="card mb-4">
                <div class="card-header fw-bold">Update status</div>
                <div class="card-body d-flex gap-2">
                    <button class="btn btn-success" @click="updateStatus('CONFIRMED')">Confirm</button>
                    <button class="btn btn-danger" @click="updateStatus('FAILED')">Fail</button>
                </div>
            </div>
        </template>

        <button 
            x-data 
            @click="let prev = document.referrer; window.location.href = prev ? prev : '/'" class="btn btn-primary">← Return</button>
    </div>

    <!-- Loader -->
    <div x-show="!item" class="text-center mt-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p>Loading...</p>
    </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
    Alpine.data('itemDetails', (itemId) => ({
        item: null,

        async fetchDetails() {
            try {
                const response = await fetch(`/api/items/${itemId}`);
                if (!response.ok) throw new Error(`Error: ${response.status}`);
                this.item = await response.json();
            } catch (error) {
                console.error("Reload error: ", error);
            }
        },

        async init() {
            await this.fetchDetails();
            socket.on('db_event', () => {
                this.fetchDetails();
            });
        },
        async updateStatus(status) {
          if (!confirm(`${status} item #${this.item.id} ?`)) return;
          await fetch(`/api/items/${this.item.id}/status`, {
              method: 'PATCH',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ status: { status } })
          });
        },
    }));
});
</script>
{% endblock %}