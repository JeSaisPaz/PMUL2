{% extends "layout.twig" %}

{% block body %}
<div class="table-responsive">
    <h1>{{title}}</h1>
    <table id="ordersTable" class="table table-striped border">
        <thead>
            <tr>
                <th>ID</th>
                <th>Created at</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script>
$(document).ready(function() {
    // On stocke l'instance de la table dans une variable
    const table = $('#ordersTable').DataTable({
        ajax: { 
            url: '/api/orders', 
            dataSrc: '' 
        },
        autoWidth: false,
        columns: [
            { 
                data: 'id',
                render: (id) => `<a href="/orders/${id}" class="fw-bold">#${id}</a>`
            },
            { 
                data: 'createdAt', 
                render: (d) => d ? new Date(d).toLocaleString('fr-FR') : '---' 
            },
            { 
                data: 'status',
                render: (s) => `<span class="badge bg-primary">${s}</span>`
            },
            {
                data: 'id',
                render: (id) => `<button class="btn btn-sm btn-danger" onclick="deleteOrder(${id})">Delete</button>`
            }
        ],
        order: [[0, 'desc']]
    });

    // update toutes les 5sec
    setInterval(() => {
        table.ajax.reload(null, false); 
    }, 5000);
});

async function deleteOrder(id) {
    if (confirm('Delete order #' + id + ' ?')) {
        await fetch(`/api/orders/${id}`, { method: 'DELETE' });
        $('#ordersTable').DataTable().ajax.reload(null, false);
    }
}
</script>
{% endblock %}