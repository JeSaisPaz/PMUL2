{% extends "layout.twig" %}

{% block body %}
<div class="table-responsive p-3">
    <div class="d-flex justify-content-between mb-3">
        <h1>{{title}}</h1>
        <a href="/neworder" class="btn btn-outline-secondary">Place an order</a>
    </div>
    <table id="ordersTable" class="table table-striped border">
        <thead>
            <tr>
                <th>Created at</th>
                <th>ID</th>
                <th>Updated at</th>
                <th>Completed at</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script>
$(document).ready(function() {
    // On stocke l'instance de la table dans une variable
    const table = $('#ordersTable').DataTable({
        ajax: { 
            url: '/api/orders', 
            dataSrc: '' 
        },
        autoWidth: false,
        columns: [
            { 
                data: 'createdAt', 
                render: (date) => date ? new Date(date).toLocaleString('fr-FR') : '---' 
            },
            { 
                data: 'id',
                render: (id) => `<a href="/orders/${id}" class="fw-bold">#${id}</a>`
            },
            { 
                data: 'updatedAt', 
                render: (date) => date ? new Date(date).toLocaleString('fr-FR') : '---' 
            },
            { 
                data: 'completedAt', 
                render: (date) => date ? new Date(date).toLocaleString('fr-FR') : '---' 
            },
            {
                data: 'status',
                render: (status) => {
                    const classes = {
                        'COMPLETED':  'bg-success',
                        'CANCELLED':  'bg-danger',
                        'IN_PROCESS': 'bg-info'
                    }
                    const badge = classes[status] ?? 'bg-secondary'
                    return `<span class="badge rounded-pill ${badge}">${status}</span>`
                }
            },
            {
                data: 'id',
                render: (id) => `<div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-danger" onclick="deleteOrder(${id})">Delete</button>
                                    <button class="btn btn-sm btn-danger" onclick="cancelOrder(${id})">Cancel</button>
                                 </div>`
            }
        ],
        order: [[0, 'desc']]
    });

    // update toutes les 5sec
    setInterval(() => {
        table.ajax.reload(null, false); 
    }, 5000);
});

async function deleteOrder(id) {
    if (confirm('Delete order #' + id + ' ?')) {
        await fetch(`/api/orders/${id}/delete`, { method: 'DELETE' });
        $('#ordersTable').DataTable().ajax.reload(null, false);
    }
}

async function cancelOrder(id) {
    if (confirm('Cancel order #' + id + ' ?')) {
        await fetch(`/api/orders/${id}/cancel`, { 
            method: 'PATCH',
        });
        $('#ordersTable').DataTable().ajax.reload(null, false);
    }
}
</script>
{% endblock %}