{% extends "layout.twig" %}

{% block body %}
<div class="table-responsive p-3">
    <h1>{{title}}</h1>
    <table id="itemsTable" class="table table-striped border">
        <thead>
            <tr>
                <th>Scanned at</th>
                <th>ID</th>
                <th>Color</th>
                <th>Team</th>
                <th>Status</th>
                <th>Decision</th>
                <th>Decision status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<script>
$(document).ready(function() {
    // On stocke l'instance de la table dans une variable
    const table = $('#itemsTable').DataTable({
        ajax: { 
            url: '/api/items', 
            dataSrc: '' 
        },
        autoWidth: false,
        columns: [
            { 
                data: 'READ_CYCLE.scannedAt', 
                render: (date) => date ? new Date(date).toLocaleString('fr-FR') : '---' 
            },
            { 
                data: 'id',
                orderSequence: ['desc', 'asc'],
                render: (id) => `<a href="/items/${id}" class="fw-bold">#${id}</a>`
            },
            { 
                data: 'COLOR', 
                render: (color) => `
                    <div class="d-flex align-items-center">
                        <span 
                            class="p-2 border rounded-circle me-2" 
                            style="background-color: ${color.hex}">
                        </span>
                        <span>${color.name}</span>
                    </div>
                `
            },
            { 
                data: 'team'
            },
            {
                data: 'ITEM_HISTORY',
                render: (history) => {
                    const badges = {
                        'AVAILABLE':  'bg-success',
                        'EXTERNAL':  'bg-danger',
                        'IN_PROCESS': 'bg-info',
                        'ORDERED':  'bg-primary',
                    }
                    const badge = badges[history[0].status] ?? 'bg-secondary'
                    return `<span class="badge rounded-pill ${badge}">${history[0].status}</span>`
                }
            },
            { 
                data: 'decision'
            },
            {
                data: 'SELECTION_HISTORY',
                render: (history) => {
                    const badges = {
                        'CONFIRMED':  'bg-success',
                        'FAILED':  'bg-danger',
                        'IN_PROCESS': 'bg-info',
                    }
                    const badge = badges[history[0].status] ?? 'bg-secondary'
                    return `<span class="badge rounded-pill ${badge}">${history[0].status}</span>`
                }
            },
            {
                data: 'id',
                render: (id) => `<button class="btn btn-sm btn-danger" onclick="deleteItem(${id})">Delete</button>`
            }
        ],
        order: [[0, 'desc']]
    });

    // update toutes les 5sec
    setInterval(() => {
        table.ajax.reload(null, false); 
    }, 5000);
});

async function deleteItem(id) {
    if (confirm('Delete item #' + id + ' ?')) {
        await fetch(`/api/items/${id}/delete`, { method: 'DELETE' });
        $('#itemsTable').DataTable().ajax.reload(null, false);
    }
}
</script>
{% endblock %}