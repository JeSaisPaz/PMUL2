{% extends "layout.twig" %}

{% block body %}
  <h1>{{title}}</h1>
  <div class="table-responsive">
    <table class="table table-hover table-striped">
      <thead>
        <tr>
          <th>Scanned on</th>
          <th>ID</th>
          <th>Color</th>
          <th>Team</th>
          <th>Status</th>
          <th>Decision</th>
          <th>Decision status</th>
          <th>Decided at</th>
          <th>Updated at</th>
        </tr>
      </thead>
      <tbody>
        {% for item in items %}
          <tr>
            <td>{{ item.READ_CYCLES.scannedAt | date('d/m/Y H:i') }}</td>
            <td>{{ item.id }}</td>
            <td>{{ item.COLOR.color }}</td>
            <td>{{ item.team }}</td>
            <td>{{ item.status }}</td>
            <td>{{ item.SELECTION_HISTORY.decision }}</td>
            <td>{{ item.SELECTION_HISTORY.status }}</td>
            <td>{{ item.SELECTION_HISTORY.decisionTakenAt | date('d/m/Y H:i') }}</td>
            <td>{{ item.SELECTION_HISTORY.statusUpdatedAt | date('d/m/Y H:i') }}</td>
          </tr>
        {% else %}
          <tr>
            <td class="text-center" colspan="9">Aucun résultat</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  <div>
  {{error}}
{% endblock %}
