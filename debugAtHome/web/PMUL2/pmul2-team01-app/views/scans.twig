{% extends "layout.twig" %}

{% block body %}
<div class="card">
    <div class="card-header"> <h1>{{title}}</h1> </div>
    <div class="card-body p-3">
        <table id="scansTable" class="table table-striped border" width="100%">
            <thead>
                <tr>
                    <th class="all">Scanned at</th>
                    <th class="all">ID</th>
                    <th class="min-tablet">QR Value</th>
                    <th class="min-tablet">HSV</th>
                    <th class="min-tablet">Item</th>
                    <th class="all">Decision</th>
                    <th data-orderable="false" class="all"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script>
$(document).ready(function() {
    const table = $('#scansTable').DataTable({
        ajax: { 
            url: '/api/scans', 
            dataSrc: '' 
        },
        responsive: true,
        autoWidth: false,
        columns: [
            { 
                data: 'scannedAt',
                type: 'date', 
                render: (date) => date ? new Date(date).toLocaleString('fr-FR') : '---' 
            },
            { 
                data: 'id',
                render: (id) => `<span class="fw-bold text-body">#${id}</span>`
            },
            { 
                data: 'qrValue',
                render: (data) => {
                    if (!data) return '<span class="text-muted small">---</span>';
                    const badgeClass = (data === 'TEAM 01') ? 'badge bg-success' : 'badge bg-secondary';
                    if (data.length > 10) return'<span class="badge bg-warning">Too long </span>';
                    return `<span class="${badgeClass}">${data}</span>`
                }
            },
            { 
                data: null,
                render: (row) => `  <div class="d-flex gap-1">
                                        <span class="badge bg-primary" style="min-width: 50px;">${row.hue}</span>
                                        <span class="badge bg-info" style="min-width: 50px;">${row.saturation}</span>
                                        <span class="badge bg-warning" style="min-width: 50px;">${row.value}</span>
                                    </div>`
            },
            {
                data: 'ITEM',
                render: (item) => {
                    if (!item) return '<span class="badge bg-secondary">NONE</span>'
                    return `<a href="/items/${item.id}" class="btn btn-sm btn-primary">#${item.id}</a>`
                }
            },
            {
                data: 'ITEM',
                render: (item) => {
                    if (!item) return '<span class="badge bg-secondary">NONE</span>'
                    const classes = {
                        'ORDER': 'bg-info',
                        'STOCK': 'bg-primary',
                        'PASS':  'bg-warning'
                    }
                    const badge = classes[item.decision] ?? 'bg-secondary'
                    return `<span class="badge rounded-pill ${badge}">${item.decision}</span>`
                }
            },
            {
                data: 'id',
                render: (id) => `<button class="btn btn-sm btn-danger" onclick="deleteScan(${id})">X</button>`
            }
        ],
        order: [[0, 'desc']]
    });

    socket.on('db_event', function() {
        table.ajax.reload(null, false); 
    });
});

async function deleteScan(id) {
    if (confirm('Delete scan #' + id + ' ?')) {
        await fetch(`/api/scans/${id}/delete`, { method: 'DELETE' });
    }
}
</script>
{% endblock %}