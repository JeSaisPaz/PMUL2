{% extends "layout.twig" %}

{% block body %}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h1>{{ title }}</h1>
        <button class="btn btn-sm btn-outline-secondary" onclick="clearLogs()">Clear</button>
    </div>
    <div class="card-body p-3">
        <div id="logsBox"
             style="font-family: monospace; font-size: 0.85em; height: 500px;
                    overflow-y: auto; background: #1e1e1e; color: #d4d4d4;
                    border-radius: 6px; padding: 12px;">
            <span class="text-muted">Waiting for logs...</span>
        </div>
    </div>
</div>

<script>
    const box = document.getElementById('logsBox');
    const allLogs = [];

    function addLog(time, msg) {
        allLogs.push({ time, msg });
        renderLogs();
    }

    function renderLogs() {
        box.innerHTML = '';

        if (allLogs.length === 0) {
            box.innerHTML = '<span class="text-muted">Empty logs.</span>';
            return;
        }

        [...allLogs]
            .sort((a, b) => new Date(b.time) - new Date(a.time))
            .slice(0, 200)
            .forEach(l => {
                let color = '#d4d4d4';
                const msg = l.msg;
                if (msg.includes('[!]'))              color = '#f48771';
                else if (msg.includes('CONFIRMED'))   color = '#89d185';
                else if (msg.includes('FAILED'))      color = '#f48771';
                else if (msg.includes('[SCAN]'))      color = '#dcdcaa';
                else if (msg.includes('[BACKEND]'))   color = '#9cdcfe';
                else if (msg.includes('[BOOT]') || msg.includes('[SIO]')) color = '#c586c0';

                const line = document.createElement('div');
                line.innerHTML = `<span style="color:#6a9955">${l.time}</span>  <span style="color:${color}">${msg}</span>`;
                box.appendChild(line);
            });
    }

    function clearLogs() {
        allLogs.length = 0;
        box.innerHTML = '<span class="text-muted">Empty logs.</span>';
    }

    fetch('/api/python/logs')
        .then(r => r.json())
        .then(logs => {
            allLogs.push(...logs);
            renderLogs();
        });

    socket.on('py_log', (data) => addLog(data.time, data.msg));
</script>
{% endblock %}