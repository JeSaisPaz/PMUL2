{% extends "layout.twig" %}

{% block body %}
<div class="card" x-data="logViewer()">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h1>{{ title }}</h1>
        <button class="btn btn-sm btn-outline-secondary" @click="clearLogs()">Clear</button>
    </div>
    <div class="card-body p-3">
        <div id="logsBox"
             style="font-family: monospace; font-size: 0.85em; height: 500px;
                    overflow-y: auto; background: #1e1e1e; color: #d4d4d4;
                    border-radius: 6px; padding: 12px;">
            <template x-if="logs.length === 0">
                <span class="text-muted">Waiting for logs...</span>
            </template>
            <template x-for="l in logs" :key="l.time + l.msg">
                <div>
                    <span style="color:#6a9955" x-text="l.time"></span>
                    &nbsp;&nbsp;
                    <span :style="'color:' + color(l.msg)" x-text="l.msg"></span>
                </div>
            </template>
        </div>
    </div>
</div>

<script>
    function logViewer() {
        return {
            logs: [],

            color(msg) {
                if (msg.includes('[!]'))                              return '#f48771';
                if (msg.includes('CONFIRMED'))                        return '#89d185';
                if (msg.includes('FAILED'))                           return '#f48771';
                if (msg.includes('[SCAN]'))                           return '#dcdcaa';
                if (msg.includes('[BACKEND]'))                        return '#9cdcfe';
                if (msg.includes('[BOOT]') || msg.includes('[SIO]')) return '#c586c0';
                return '#d4d4d4';
            },

            fetchLogs() {
                fetch('/api/python/logs')
                    .then(r => r.json())
                    .then(logs => { this.logs = logs; this.scrollBottom(); });
            },

            clearLogs() {
                fetch('/api/python/logs', { method: 'DELETE' });
            },

            init() {
                this.fetchLogs();
                socket.on('py_log', () => this.fetchLogs());
            }
        }
    }
</script>
{% endblock %}