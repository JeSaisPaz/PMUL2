{% extends "layout.twig" %}

{% block body %}
<div class="card" x-data="logViewer()">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h1>{{ title }}</h1>
        <button class="btn btn-sm btn-outline-secondary" @click="clearLogs()">Clear</button>
    </div>
    <div class="card-body p-3">
        <div id="logsBox"
             style="font-family: monospace; font-size: 0.85em; height: 500px;
                    overflow-y: auto; background: #1e1e1e; color: #d4d4d4;
                    border-radius: 6px; padding: 12px;">
            <template x-if="logs.length === 0">
                <span class="text-muted">Waiting for logs...</span>
            </template>
            <template x-for="l in logs" :key="l.time + l.msg">
                <div>
                    <span style="color:#6a9955" x-text="l.time"></span>
                    <span style="margin-left: 8px;" :style="'color:' + color(l.msg)" x-text="l.msg"></span>
                </div>
            </template>
        </div>
    </div>
</div>

<script>
    function logViewer() {
        return {
            logs: [],

            color(msg) {
                if (msg.includes('[!]'))         return '#f48771'; // erreurs / warnings
                if (msg.includes('CONFIRMED'))   return '#89d185'; // tri confirmé
                if (msg.includes('FAILED'))      return '#f48771'; // tri échoué
                if (msg.includes('[QR]'))        return '#dcdcaa'; // scan QR
                if (msg.includes('[SCAN]'))      return '#dcdcaa'; // scan générique
                if (msg.includes('[BACKEND]'))   return '#9cdcfe'; // réponses backend
                if (msg.includes('[ARDUINO]'))   return '#ce9178'; // trames Arduino
                if (msg.includes('[SERIAL]'))    return '#ce9178'; // détection port série
                if (msg.includes('[SIO]'))       return '#c586c0'; // socket.io
                if (msg.includes('[BOOT]'))      return '#c586c0'; // démarrage
                if (msg.includes('[CAM]'))       return '#4ec9b0'; // caméra
                if (msg.includes('[COLORS]'))    return '#4ec9b0'; // couleurs envoyées
                if (msg.includes('[ORDER]'))     return '#569cd6'; // commandes
                if (msg.includes('[COMPLETED]')) return '#89d185'; // commandes complètes
                if (msg.includes('[OK]'))        return '#89d185'; // succès génériques
                if (msg.includes('[PI_DRIVER]')) return '#d7ba7d'; // boot principal
                return '#d4d4d4';
            },

            fetchLogs() {
                fetch('/api/python/logs')
                    .then(r => r.json())
                    .then(logs => { this.logs = logs; this.scrollBottom(); });
            },

            clearLogs() {
                fetch('/api/python/logs', { method: 'DELETE' });
            },

            init() {
                this.fetchLogs();
                socket.on('py_log', () => this.fetchLogs());
            }
        }
    }
</script>
{% endblock %}