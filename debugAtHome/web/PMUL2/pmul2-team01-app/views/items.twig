{% extends "layout.twig" %}

{% block body %}
<div class="card">
    <div class="card-header"> <h1>{{title}}</h1> </div>
    <div class="card-body p-3">
        <table id="itemsTable" class="table table-striped border" width="100%">
            <thead>
                <tr>
                    <th class="all">Scanned at</th>
                    <th class="all">ID</th>
                    <th class="all">Color</th>
                    <th class="min-tablet">Team</th>
                    <th class="min-tablet">Status</th>
                    <th class="min-tablet">Decision</th>
                    <th class="min-tablet">Decision status</th>
                    <th data-orderable="false" class="all"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<script>
$(document).ready(function() {
    // On stocke l'instance de la table dans une variable
    const table = $('#itemsTable').DataTable({
        ajax: { 
            url: '/api/items', 
            dataSrc: '' 
        },
        responsive: true,
        autoWidth: false,
        columns: [
            { 
                data: 'READ_CYCLE.scannedAt',
                type: 'date', 
                render: (date) => date ? new Date(date).toLocaleString('fr-FR') : '<span class="text-muted">—</span>' 
            },
            { 
                data: 'id',
                orderSequence: ['desc', 'asc'],
                render: (id) => `<a href="/items/${id}" class="btn btn-sm btn-primary">#${id}</a>`
            },
            { 
                data: 'COLOR', 
                render: (color) => color ? `
                    <div class="d-flex align-items-center">
                        <span 
                            class="p-2 border rounded-circle me-2" 
                            style="background-color: ${color.hex}">
                        </span>
                        <span>${color.name}</span>
                    </div>
                ` : '<span class="text-muted">—</span>'
            },
            { 
                data: 'team',
                render: (data) => {
                    if (!data) return '<span class="text-muted">—</span>';
                    const badgeClass = (data === 'TEAM 01') ? 'badge bg-success' : 'badge bg-secondary';
                    return `<span class="${badgeClass}">${data}</span>`
                }
            },
            {
                data: 'status',
                render: (status) => {
                    const badges = {
                        'AVAILABLE':  'bg-success',
                        'EXTERNAL':  'bg-warning',
                        'PROCESS': 'bg-info',
                        'ORDERED':  'bg-primary',
                        'CANCELLED':  'bg-danger',
                    }
                    const badge = badges[status] ?? 'bg-secondary'
                    return `<span class="badge rounded-pill ${badge}">${status}</span>`
                }
            },
            {
                data: 'decision',
                render: (decision) => {
                    const classes = {
                        'ORDER': 'bg-info',
                        'STOCK': 'bg-primary',
                        'PASS':  'bg-warning'
                    }
                    const badge = classes[decision] ?? 'bg-secondary'
                    return `<span class="badge rounded-pill ${badge}">${decision}</span>`
                }
            },
            {
                data: 'decisionStatus',
                render: (status) => {
                    const badges = {
                        'CONFIRMED':  'bg-success',
                        'FAILED':  'bg-danger',
                        'PROCESS': 'bg-info',
                    }
                    const badge = badges[status] ?? 'bg-secondary'
                    return `<span class="badge rounded-pill ${badge}">${status}</span>`
                }
            },
            {
                data: 'id',
                render: (id) => `<button class="btn btn-sm btn-danger" onclick="deleteItem(${id})">X</button>`
            }
        ],
        order: [[0, 'desc']]
    });

    // update du front a chaque event de la db donc pas besoin de l'event d'update
    socket.on('db_event', function() {
        table.ajax.reload(null, false); 
    });

});

async function deleteItem(id) {
    if (confirm('Delete item #' + id + ' ?')) {
        await fetch(`/api/items/${id}/delete`, { method: 'DELETE' });
    }
}
</script>
{% endblock %}